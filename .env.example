# ─────────────────────────────────────────────────────────────
# Jobless Turtle — ortam değişkenleri
# cp .env.example .env ve değerleri doldurun. .env dosyasını asla commit etmeyin.
# ─────────────────────────────────────────────────────────────

# Arayüzün dışarıdan erişildiği adres (tünel hostname'i). OAuth dönüşleri ve bildirim linkleri bunu kullanır.
APP_PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Veritabanı (yalnızca konteyner ağı içinde erişilir)
POSTGRES_USER=jobtrack
POSTGRES_PASSWORD=degistir-guclu-bir-parola
POSTGRES_DB=jobtrack

# Güvenlik — üretmek için: openssl rand -base64 48  /  openssl rand -base64 32
JWT_SECRET=degistir-en-az-32-karakter-rastgele-deger
# Tam 32 bayt base64 olmalı (openssl rand -base64 32). Token ve uygulama parolalarını şifreler; kaybolursa bağlı hesaplar yeniden bağlanmalıdır.
APP_ENCRYPTION_KEY=
WEBHOOK_SECRET=degistir-webhook-sirri

# Kayıt: invite (varsayılan, ilk kullanıcı yönetici olur, sonrakiler davet kodu ister) | open
REGISTRATION_MODE=invite
# İlk açılışta demo verisi (demo@ornek.local / demo12345). Gerçek kullanımda false bırakın.
SEED_DEMO=false

# Test e-posta sağlayıcısı (gerçek gönderim yapmaz). Pilot sonrası kapatabilirsiniz.
FAKE_MAIL_ENABLED=true

# Gmail OAuth (yalnızca gmail.send kapsamı) — docs/SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram bildirim botu — docs/SETUP.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# AI köprüsü
# Worker imajına Claude Code ve Codex CLI kur (kişisel aboneliğinle giriş yapman gerekir)
INSTALL_AI_CLI=false
CLAUDE_CLI_PATH=claude
# Claude Code CLI modeli: sonnet (Sonnet'in güncel sürümü), opus veya tam model kimliği
CLAUDE_CLI_MODEL=sonnet
CODEX_CLI_PATH=codex
AI_CLI_WEB_RESEARCH=true
# Derin adres aramasında tahmini adresler posta sunucusuna "bu kutu var mı" diye sorulur (mail gönderilmez; 25. port gerekir)
CONTACT_SMTP_PROBE=true
# Yoklamada kendini tanıtırken kullanılan ad; boşsa APP_PUBLIC_URL'nin alan adı
# SMTP_PROBE_HELO=
# İsteğe bağlı yerel model
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b-instruct
# İsteğe bağlı API anahtarları (kullanılmazsa boş bırakın)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Cloudflare named tunnel (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# Worker
SCHEDULER_ENABLED=true
# Kariyer.net / Indeed arama sayfası taraması (ayarlar arayüzden: Profilim › İlan siteleri taraması). false: hiç istek atılmaz.
SCRAPERS_ENABLED=true
DIGEST_HOUR=9
