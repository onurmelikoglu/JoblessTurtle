{
  "name": "jobtracking-backend",
  "version": "1.0.0",
  "private": true,
  "description": "İş ve Firma Takip Asistanı — API ve worker",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start:api": "node dist/src/main.js",
    "start:worker": "node dist/src/worker.js",
    "dev:api": "ts-node --transpile-only src/main.ts",
    "dev:worker": "ts-node --transpile-only src/worker.ts",
    "scrapers:check": "ts-node --transpile-only src/scraper-check.ts",
    "scrapers:check:prod": "node dist/src/scraper-check.js",
    "extension:extractors": "ts-node --transpile-only src/extension-extractors.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --config jest.config.js --selectProjects unit",
    "test:e2e": "jest --config jest.config.js --selectProjects e2e --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:seed:prod": "node dist/prisma/seed.js"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "bullmq": "5.81.5",
    "cheerio": "1.2.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "exceljs": "4.4.0",
    "imapflow": "2.0.5",
    "ioredis": "5.11.1",
    "luxon": "3.7.2",
    "mailparser": "3.9.28",
    "nodemailer": "7.0.13",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/luxon": "3.7.6",
    "@types/mailparser": "3.4.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.4",
    "@types/nodemailer": "7.0.12",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
